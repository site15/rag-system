PRISMA_ENGINES_MIRROR=https://registry.npmmirror.com/-/binary/prisma
PRISMA_BINARIES_MIRROR=http://prisma-builds.s3-eu-west-1.amazonaws.com

DATABASE_URL="postgresql://rag_system_user:c9pc5fQ81ME03VgfpU1Wuhlb3EjX069gC4QQ@localhost:25432/rag_system_db?schema=public"
PORT=23000

# LLM context packing (max combined chunk chars per request: ChatLlmModel.chunkSize in DB)
# Reserved chars for prompt template (history, question, instructions)
LLM_CONTEXT_PROMPT_RESERVE=2000
# Minimum context length floor
LLM_MIN_CONTEXT_CHARS=1000
# How many chunks to retrieve from vector search (more = better fill up to max context)
RAG_GLOBAL_SEARCH_LIMIT=150
RAG_TELEGRAM_SEARCH_LIMIT=150

CHAT_PROVIDER=ollama
# OPENAI_CHAT_API_KEY=lm-studio
# GROQ_CHAT_API_KEY=gsk_XXX
# Z_AI_CHAT_API_KEY=z_XXX
# OPENROUTER_CHAT_API_KEY=sk-or-v1-XXX

EMBEDDINGS_PROVIDER=ollama
OLLAMA_EMBEDDINGS_MODEL=nomic-embed-text
OLLAMA_EMBEDDINGS_BASE_URL=http://localhost:21434

ADMIN_API_KEYS=a1a9a512-aceb-49cf-83ac-a0b534486e0b
SOURCES_PATH=../sources
PARALLEL_THREADS=1
ENABLE_FILE_LOGGING=true
# Log full LLM prompt/response in console and trace (set false in production)
LLM_LOG_FULL_PROMPT=true
MAX_CONSECUTIVE_FAILURES=7
PROCESS_DOCUMENTS=false
CREATE_DUMP_DOCUMENTS=false
# Offline graph metadata extraction (npm run fill-graph-content)
GRAPH_EMBED_DELAY_MS=0
CHECK_IP=false
ALLOWED_IPS=127.0.0.1,192.168.168.1,::1

# Proxy Configuration (optional)
# GLOBAL_HTTP_PROXY=http://user:password@ip:port
# GLOBAL_HTTPS_PROXY=http://user:password@ip:port
# HTTP_PROXY=http://user:password@ip:port
# HTTPS_PROXY=http://user:password@ip:port
# NO_PROXY=localhost,127.0.0.1,::1